# Copy to .env and fill in. Never commit .env.

# Hugging Face (optional: only needed for higher rate limits; dataset is public)
HF_TOKEN=

# Model service (FastAPI)
MODEL_SERVICE_PORT=8000
# MODEL_DIR (optional): folder with model.joblib, suggest.joblib, model_card.json.
# Defaults to ml/models/final. Set it as an environment variable when starting uvicorn.
# MODEL_DIR=

# Express API
PORT=4000
MODEL_SERVICE_URL=http://localhost:8000
MONGODB_URI=mongodb://localhost:27017/captionscore
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# React frontend (Vite exposes only VITE_* vars)
VITE_API_URL=http://localhost:4000
